---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p>© {today.getFullYear()} LukeMagic. All rights reserved.</p>

		<div class="social">
			<a
				href="https://x.com/Lukemaigc"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Luke on X"
			>
				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
					width="22"
					height="22"
					fill="currentColor"
				>
					<path d="M18.244 2H21.5l-7.11 8.128L22.75 22h-6.546l-5.126-6.704L5.21 22H1.95l7.606-8.694L1.5 2h6.712l4.633 6.124L18.244 2Zm-1.143 18h1.804L7.23 3.895H5.294L17.101 20Z" />
				</svg>
			</a>

			<a
				href="https://github.com/lukemagicman"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Luke on GitHub"
			>
				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
					width="22"
					height="22"
					fill="currentColor"
				>
					<path d="M12 2C6.477 2 2 6.484 2 12.021c0 4.428 2.865 8.184 6.839 9.504.5.092.682-.217.682-.483 0-.237-.009-.866-.014-1.7-2.782.605-3.369-1.343-3.369-1.343-.455-1.158-1.11-1.466-1.11-1.466-.908-.621.069-.608.069-.608 1.004.071 1.532 1.032 1.532 1.032.892 1.53 2.341 1.088 2.91.832.091-.647.349-1.088.635-1.338-2.221-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.987 1.029-2.686-.103-.254-.446-1.272.098-2.65 0 0 .84-.269 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.295 2.748-1.026 2.748-1.026.546 1.378.203 2.396.1 2.65.64.699 1.028 1.593 1.028 2.686 0 3.848-2.337 4.695-4.566 4.943.359.31.678.921.678 1.856 0 1.34-.012 2.421-.012 2.75 0 .269.18.58.688.481A10.025 10.025 0 0 0 22 12.021C22 6.484 17.523 2 12 2Z" />
				</svg>
			</a>
		</div>
	</div>
</footer>

<style>
	footer {
		margin-top: 4rem;
		border-top: 1px solid #e5e7eb;
	}

	.footer-inner {
		max-width: 960px;
		margin: 0 auto;
		padding: 2rem 1.5rem 3rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	p {
		margin: 0;
		font-size: 0.9rem;
		color: #777;
	}

	.social {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.social a {
		display: flex;
		align-items: center;
		justify-content: center;
		color: #555;
		transition:
			color 0.2s ease,
			transform 0.2s ease;
	}

	.social a:hover {
		color: #111;
		transform: translateY(-2px);
	}

	@media (max-width: 600px) {
		.footer-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>