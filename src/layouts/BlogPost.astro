---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
	title,
	description,
	pubDate,
	updatedDate,
} = Astro.props;

const published = pubDate.toLocaleDateString('zh-CN', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

const updated = updatedDate
	? updatedDate.toLocaleDateString('zh-CN', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		})
	: null;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} | LukeMagic`} description={description} />
	</head>

	<body>
		<Header />

		<main>
			<article>
				<header class="article-header">
					<a class="back" href="/blog/">← 返回 Blog</a>

					<h1>{title}</h1>

					<p class="description">{description}</p>

					<div class="meta">
						<span>发布于 {published}</span>

						{
							updated && (
								<span>更新于 {updated}</span>
							)
						}
					</div>
				</header>

				<div class="content">
					<slot />
				</div>
			</article>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 820px;
		margin: 0 auto;
		padding: 5rem 1.5rem 7rem;
	}

	.article-header {
		padding-bottom: 3rem;
		border-bottom: 1px solid #e5e7eb;
	}

	.back {
		display: inline-block;
		margin-bottom: 2rem;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
	}

	.article-header h1 {
		margin: 0;
		font-size: clamp(2.8rem, 7vw, 5rem);
		line-height: 1.08;
		letter-spacing: -0.045em;
	}

	.description {
		max-width: 700px;
		margin: 1.5rem 0 0;
		font-size: 1.15rem;
		line-height: 1.8;
		color: #555;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 1.2rem;
		margin-top: 1.5rem;
		font-size: 0.85rem;
		color: #777;
	}

	.content {
		padding-top: 3rem;
		font-size: 1.08rem;
		line-height: 1.9;
	}

	.content :global(h2) {
		margin: 3rem 0 1rem;
		font-size: 1.8rem;
		line-height: 1.3;
	}

	.content :global(h3) {
		margin: 2.3rem 0 0.8rem;
		font-size: 1.35rem;
	}

	.content :global(p) {
		margin: 1.2rem 0;
	}

	.content :global(ul),
	.content :global(ol) {
		margin: 1.2rem 0;
		padding-left: 1.5rem;
	}

	.content :global(li) {
		margin: 0.45rem 0;
	}

	.content :global(a) {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.content :global(blockquote) {
		margin: 2rem 0;
		padding-left: 1.2rem;
		border-left: 3px solid #d1d5db;
		color: #555;
	}

	.content :global(code) {
		padding: 0.15em 0.35em;
		border-radius: 5px;
		background: #f3f4f6;
		font-size: 0.92em;
	}

	.content :global(pre) {
		overflow-x: auto;
		margin: 2rem 0;
		padding: 1.3rem;
		border-radius: 12px;
		background: #111827;
	}

	.content :global(pre code) {
		padding: 0;
		background: transparent;
		color: #f9fafb;
	}

	.content :global(img) {
		max-width: 100%;
		height: auto;
		margin: 2rem auto;
		border-radius: 12px;
	}

	@media (max-width: 720px) {
		main {
			padding: 3rem 1.25rem 5rem;
		}

		.article-header h1 {
			font-size: clamp(2.5rem, 12vw, 3.8rem);
		}

		.content {
			font-size: 1rem;
		}
	}
</style>
