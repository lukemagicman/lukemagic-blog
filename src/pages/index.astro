---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<p class="eyebrow">TECH · AI · NOTES</p>

				<h1>Hi, I'm Luke.</h1>

				<p class="intro">
					欢迎来到 LukeMagic。这里记录我的技术折腾、AI 工具、个人思考，
					以及一些值得长期留下来的东西。
				</p>

				<div class="actions">
					<a class="primary" href="/blog/">阅读文章</a>
					<a class="secondary" href="#projects">看看我在折腾什么</a>
				</div>
			</section>

			<section class="section">
				<div class="section-title">
					<h2>Latest</h2>
					<a href="/blog/">全部文章 →</a>
				</div>

				<div class="empty-card">
					<p>新的文章会陆续出现在这里。</p>
				</div>
			</section>

			<section class="section" id="projects">
				<div class="section-title">
					<h2>Exploring</h2>
				</div>

				<div class="project-grid">
					<article class="project-card">
						<span>01</span>
						<h3>Tech Experiments</h3>
						<p>
							硬件、网络、软件，以及各种突然冒出来又忍不住去折腾的技术项目。
						</p>
					</article>

					<article class="project-card">
						<span>02</span>
						<h3>AI Workflow</h3>
						<p>
							记录 AI 工具、Agent、自动化，以及我实际使用中的方法和体验。
						</p>
					</article>

					<article class="project-card">
						<span>03</span>
						<h3>Notes & Thoughts</h3>
						<p>
							一些个人思考、经验记录，以及值得以后重新翻出来看的东西。
						</p>
					</article>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 960px;
		margin: 0 auto;
		padding: 4rem 1.5rem 6rem;
	}

	.hero {
		padding: 5rem 0 6rem;
	}

	.eyebrow {
		margin: 0 0 1.25rem;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		color: #666;
	}

	.hero h1 {
		margin: 0;
		font-size: clamp(3.2rem, 8vw, 6rem);
		line-height: 0.95;
		letter-spacing: -0.05em;
	}

	.intro {
		max-width: 720px;
		margin: 2rem 0 0;
		font-size: 1.25rem;
		line-height: 1.8;
		color: #444;
	}

	.actions {
		display: flex;
		gap: 1rem;
		margin-top: 2.5rem;
	}

	.actions a {
		display: inline-block;
		padding: 0.85rem 1.3rem;
		border-radius: 10px;
		text-decoration: none;
		font-weight: 600;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}

	.actions a:hover {
		transform: translateY(-2px);
	}

	.primary {
		background: #111827;
		color: white;
	}

	.secondary {
		border: 1px solid #d1d5db;
		color: #111827;
	}

	.section {
		padding: 4rem 0;
		border-top: 1px solid #e5e7eb;
	}

	.section-title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.section-title h2 {
		margin: 0;
		font-size: 2rem;
	}

	.section-title a {
		text-decoration: none;
		font-size: 0.95rem;
	}

	.empty-card {
		border: 1px solid #e5e7eb;
		border-radius: 16px;
		padding: 1.5rem;
	}

	.empty-card p {
		margin: 0;
		color: #555;
		line-height: 1.7;
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.project-card {
		border: 1px solid #e5e7eb;
		border-radius: 16px;
		padding: 1.5rem;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.project-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
	}

	.project-card span {
		font-size: 0.8rem;
		font-weight: 600;
		color: #777;
	}

	.project-card h3 {
		margin: 1rem 0 0.6rem;
		font-size: 1.25rem;
	}

	.project-card p {
		margin: 0;
		line-height: 1.7;
		color: #555;
	}

	@media (max-width: 720px) {
		main {
			padding: 2rem 1.25rem 4rem;
		}

		.hero {
			padding: 3rem 0 4rem;
		}

		.hero h1 {
			font-size: clamp(3rem, 15vw, 4.5rem);
		}

		.intro {
			font-size: 1.1rem;
		}

		.project-grid {
			grid-template-columns: 1fr;
		}

		.actions {
			flex-wrap: wrap;
		}
	}
</style>