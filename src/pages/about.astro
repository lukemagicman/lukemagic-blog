---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const description =
	'关于 LukeMagic，一个记录技术折腾、AI 工具、互联网探索与个人思考的个人网站。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={description} />
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<p class="eyebrow">ABOUT</p>

				<h1>Hi, I'm Luke.</h1>

				<p class="lead">
					这里是 LukeMagic，
					一个用来记录技术折腾、AI 工具、互联网探索和个人思考的地方。
				</p>
			</section>

			<section class="section">
				<h2>关于我</h2>

				<div class="prose">
					<p>
						我喜欢研究各种有意思的东西。
					</p>

					<p>
						有时候是一项新技术，有时候是一个 AI 工具，
						也可能是一台不起眼的硬件、一个软件问题，
						或者某个突然冒出来、让我忍不住继续研究的问题。
					</p>

					<p>
						比起单纯得到一个答案，我更喜欢弄清楚它为什么这样工作，
						然后自己动手试一遍。
					</p>
				</div>
			</section>

			<section class="section">
				<h2>这里会有什么</h2>

				<div class="cards">
					<article>
						<span>01</span>
						<h3>技术折腾</h3>
						<p>
							硬件、软件、网络，以及各种从一个小问题逐渐发展成一个大坑的项目。
						</p>
					</article>

					<article>
						<span>02</span>
						<h3>AI & Tools</h3>
						<p>
							我实际使用过的 AI 工具、Agent、工作流，以及使用过程中的经验和想法。
						</p>
					</article>

					<article>
						<span>03</span>
						<h3>Notes & Thoughts</h3>
						<p>
							一些不一定属于特定领域，但我觉得值得记录和长期保留下来的东西。
						</p>
					</article>
				</div>
			</section>

			<section class="section last">
				<h2>为什么是 LukeMagic</h2>

				<div class="prose">
					<p>
						互联网每天都会产生大量新的内容，但真正属于自己的东西其实并不多。
					</p>

					<p>
						所以我想保留一个自己的角落。
					</p>

					<p>
						不用追逐算法，也不用给内容限定一个固定方向。
						想到什么、研究了什么、发现了什么，就慢慢记录下来。
					</p>

					<p class="ending">
						That's LukeMagic.
					</p>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 900px;
		margin: 0 auto;
		padding: 5rem 1.5rem 7rem;
	}

	.hero {
		padding-bottom: 5rem;
	}

	.eyebrow {
		margin: 0 0 1.25rem;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		color: #666;
	}

	.hero h1 {
		margin: 0;
		font-size: clamp(3.5rem, 8vw, 6rem);
		line-height: 0.95;
		letter-spacing: -0.05em;
	}

	.lead {
		max-width: 720px;
		margin: 2rem 0 0;
		font-size: 1.25rem;
		line-height: 1.8;
		color: #444;
	}

	.section {
		padding: 4rem 0;
		border-top: 1px solid #e5e7eb;
	}

	.section h2 {
		margin: 0 0 2rem;
		font-size: 2rem;
		letter-spacing: -0.02em;
	}

	.prose {
		max-width: 720px;
		font-size: 1.08rem;
		line-height: 1.9;
		color: #444;
	}

	.prose p {
		margin: 0 0 1.4rem;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.cards article {
		padding: 1.5rem;
		border: 1px solid #e5e7eb;
		border-radius: 16px;
	}

	.cards span {
		font-size: 0.8rem;
		font-weight: 600;
		color: #777;
	}

	.cards h3 {
		margin: 1rem 0 0.7rem;
		font-size: 1.2rem;
	}

	.cards p {
		margin: 0;
		line-height: 1.7;
		color: #555;
	}

	.ending {
		margin-top: 2.5rem !important;
		font-size: 1.25rem;
		font-weight: 700;
		color: #111827;
	}

	.last {
		padding-bottom: 0;
	}

	@media (max-width: 720px) {
		main {
			padding: 3rem 1.25rem 5rem;
		}

		.hero {
			padding-bottom: 4rem;
		}

		.lead {
			font-size: 1.1rem;
		}

		.cards {
			grid-template-columns: 1fr;
		}
	}
</style>